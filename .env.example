PORT=4000
# MongoDB Atlas connection string (database name in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ssvj?retryWrites=true&w=majority
# Optional: comma-separated DNS servers used for the mongodb+srv SRV lookup
DNS_SERVERS=8.8.8.8,1.1.1.1
# Secret sent as the x-admin-key header for /api/admin routes
ADMIN_KEY=change-me
# Long random string that signs login sessions and OTP hashes
SESSION_SECRET=change-me-too
# Comma-separated browser origins allowed by CORS (Capacitor Android uses https://localhost)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost

# Cloudinary — either CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud> or the three values below
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Login OTP delivery: console (prints code in server log, dev only) | fast2sms | msg91 | twilio
SMS_PROVIDER=console
# Testing phase in production: with SMS_PROVIDER=console, show the code in the app. Remove before launch.
SHOW_OTP=false
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
